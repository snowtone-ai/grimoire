# Gemini API Key (get from https://aistudio.google.com/apikey)
# Server-only: read by src/app/api/gemini/generate; never sent to the client.
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Client ID (Google Cloud Console -> APIs & Services -> Credentials).
# Public by design (NEXT_PUBLIC_*): this is a browser-side Identity Services
# client id, not a secret. Enables Google Calendar/Gmail linking
# (src/integrations/google/*); left unset, that linking simply stays
# disabled (isGoogleConfigured() returns false) instead of erroring.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id
