# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-mcp/
/test-results/
/implementation-status-desktop.png
/report-desktop.png

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# pm-zero v9.3
screenshots/*
logs/*
!screenshots/.gitkeep
!logs/.gitkeep
!.env.example
.claude/settings.local.json
.claude/worktrees/
.mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# GCP service account keys
service-account*.json
credentials.json
.claude/transcripts/
.claude/cache/
.codegraph/

# pm-zero v12.1 Section 16.7 -- reproducible via `node scripts/setup.mjs`, not vendored
.claude/skills/impeccable/

# scripts/sync-world-media.mjs output (D-013): the owner's footage copied out of
# anime/, and the ledger recording which files that copy wrote. Gigabytes of
# video, machine-local, and re-derivable from anime/ at any time. manifest.json
# is the contract src/world/media-manifest.ts reads, so it stays tracked.
/public/world/*
!/public/world/manifest.json
/public/audio/bgm/*
!/public/audio/bgm/.gitkeep
