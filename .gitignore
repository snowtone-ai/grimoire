# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-mcp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# pm-zero v9.3
screenshots/*
logs/*
!screenshots/.gitkeep
!logs/.gitkeep
!.env.example
.claude/settings.local.json
.claude/worktrees/
.mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# GCP service account keys
service-account*.json
credentials.json
.claude/transcripts/
.claude/cache/
.codegraph/

# pm-zero v12.1 §16.7 -- UI tooling auto-provisioned by scripts/setup.mjs.
